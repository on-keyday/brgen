{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "cmd",
            "args": [
                "/C",
                "build.bat"
            ]
        },
        {
            // nast のバックエンドをデバッガに乗せる版で建てる (build/debug)。
            // 既定のツリー (build/fast) はデバッグ情報を出さないので、
            // ブレークポイントを効かせるにはこちらが要る。
            //
            // launch の preLaunchTask には**しない**。デバッグのたびに走ると、
            // 拍子で全ビルドになって手が止まる。デバッグ前に必要なときだけ
            // 明示的に叩く。ターゲットを絞ってあるので、これ自体は
            // nast_core + nast_backend しか建てない。
            "label": "nast: build backend (debug info)",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/src/core/nast/build.py",
                "--debug-info",
                "--no-run",
                "-t",
                "nast_backend"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "npm_compile_server",
            "type": "npm",
            "script": "compile",
            "group": "build",
            "path": "lsp/server",
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "npm_compile_client",
            "type": "npm",
            "script": "compile",
            "group": "build",
            "path": "lsp/client",
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "npm_watch_client",
            "type": "npm",
            "script": "watch",
            "path": "lsp/client",
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc-watch"
            ],
            "dependsOn": [
                "npm_compile_client"
            ]
        },
        {
            "label": "npm_watch_server",
            "type": "npm",
            "script": "watch",
            "path": "lsp/server",
            "isBackground": true,
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "panel": "dedicated",
                "reveal": "never"
            },
            "problemMatcher": [
                "$tsc-watch"
            ],
            "dependsOn": [
                "npm_compile_server"
            ]
        },
        {
            "label": "npm_build_and_watch",
            "dependsOn": [
                "npm_watch_client",
                "npm_watch_server"
            ]
        },
    ]
}