{
  // IntelliSense を使用して利用可能な属性を学べます。
  // 既存の属性の説明をホバーして表示します。
  // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "LSP Client + Server",
      "configurations": ["Launch LSP Client", "Attach to LSP Server"]
    }
  ],
  "configurations": [
    {
      "name": "Debug brgen",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceRoot}/src/tool/brgen",
      "args": ["-config", "test-brgen.json", "-debug"],
      "cwd": "${workspaceRoot}",
      "output": "${workspaceRoot}/tool/br_debuggee"
    },
    {
      // nast のバックエンド試作 (src/core/nast/tool/backend.cpp)。
      // 乗るのは build/debug の版 (デバッグ情報つき)。既定のツリー
      // build/fast にはデバッグ情報が無くブレークポイントが効かない。
      //
      // **ビルドはしない**。先に手で建ててから起動すること:
      //   python src/core/nast/build.py --debug-info -t nast_backend --no-run
      // (デバッグのたびに全ビルドが走ると、それだけで手が止まるため)
      "name": "Debug nast backend",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/src/core/nast/build/debug/bin/nast_backend.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      // nast の他のツールを引数つきで debug したいとき用。
      // 起動時にどれを走らせるか聞かれる。こちらもビルドはしない。
      //
      // build/debug にはそのとき建てたものしか無い。選ぶ前に、そのツールを
      // 名指しで建てておくこと:
      //   python src/core/nast/build.py --debug-info -t <tool> --no-run
      "name": "Debug nast tool (pick)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/src/core/nast/build/debug/bin/${input:nastTool}.exe",
      "args": [
        "${input:nastArgs}"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "environment": [],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug src2json",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/tool/src2json",
      "args": [
        "${workspaceRoot}/example/feature_test/type_parameter.bgn",
        "--print-json",
        "--print-on-error",
        "--error-tolerant"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "environment": [],
      "console": "integratedTerminal",
      //"preLaunchTask": "build",
      "symbolSearchPath": "lib\\"
    },
    {
      "name": "Debug json2go",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "C:\\Users\\ukfco\\AppData\\Local\\Temp\\cmptest-hA8hBNemvvh4XwCaJ2cKyJern6zIiVqq\\varint_test.go\\TestVarint\\Rfwv26cTD99HRMsse8oLw74IlUtyBPTd\\test.exe",
      "args": [
        "C:\\Users\\ukfco\\AppData\\Local\\Temp\\cmptest-hA8hBNemvvh4XwCaJ2cKyJern6zIiVqq\\varint.dat",
        "C:\\Users\\ukfco\\AppData\\Local\\Temp\\cmptest-hA8hBNemvvh4XwCaJ2cKyJern6zIiVqq\\varint_test.go\\TestVarint\\Rfwv26cTD99HRMsse8oLw74IlUtyBPTd\\output.bin"
      ],
      "cwd": "${workspaceRoot}",
      "output": "${workspaceRoot}/tool/j2g_debuggee"
    },
    {
      "name": "Debug test",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/built/native/Debug/test/deep_copy_test.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "environment": [],
      "console": "integratedTerminal",
      //"preLaunchTask": "build",
      "symbolSearchPath": "lib\\"
    },
    {
      "name": "Debug json2cpp",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/tool/json2cpp2",
      "args": [
        "-f",
        "C:/workspace/shbrgen/rebrgen/save/ebm.json"
        //,"-r",
        //"-b","./example/wire_data/websocket.dat","--hex","--jit"
        //*/
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}",
      "environment": [],
      "console": "integratedTerminal",
      //"preLaunchTask": "build",
      "symbolSearchPath": "lib\\"
    },
    {
      "name": "Debug generator",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceRoot}/tool/gen_ast2csharp.exe",
      "args": ["/dev/stdout"],
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "Debug attach",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch LSP Client",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceRoot}/lsp"],
      "preLaunchTask": "npm_build_and_watch",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to LSP Server",
      "port": 6009,
      "restart": true,
      "sourceMaps": true,
      "localRoot": "${workspaceFolder}/lsp/server",
      "remoteRoot": "${workspaceFolder}/lsp/server"
    },

    {
      "type": "cppvsdbg",
      "request": "launch",
      "name": "Debug cmptest",
      "program": "${workspaceRoot}/tool/cmptest",
      "cwd": "${workspaceRoot}",
      "args": [
        "--test-info-file",
        "./ignore/example/test_info.json",
        "--test-config-file",
        "./testkit/cmptest.json",
        "-d"
      ]
    },
    {
      "name": "Node Attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "cppvsdbg",
      "request": "launch",
      "cwd": "C:\\Users\\ukfco\\AppData\\Local\\Temp\\unictest\\tr-a24c190fbf\\r-ae32a16166\\t-b991d59b6b",
      "name": "Debug ebm2zig unictest (TestPacket)",
      "program": "C:/Users/ukfco/AppData/Local/Temp/unictest/tr-a24c190fbf/r-ae32a16166/t-b991d59b6b/zig_proj/test_runner.exe",
      "args": [
        "C:/Users/ukfco/AppData/Local/Temp/unictest/tr-a24c190fbf/r-ae32a16166/t-b991d59b6b/input.bin",
        "C:/Users/ukfco/AppData/Local/Temp/unictest/tr-a24c190fbf/r-ae32a16166/t-b991d59b6b/output.bin"
      ],
      "stopAtEntry": true
    },
    {
      "name": "Debug ebm2c",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/rebrgen/tool/ebm2rmw",
      "args": [
        "-i",
        "save/http2.ebm",
        "--entry-point",
        "HTTP2FrameTest",
        "--binary-file",
        "test/binary_data/http2_frame_test.dat",
        "--dump-ops",
        "--output-file",
        "save/http2_output.bin"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}/rebrgen",
      "environment": [],
      "console": "integratedTerminal"
      //"preLaunchTask": "build",
      //"symbolSearchPath": "lib\\"
    },
    {
      "name": "Debug ebm2cpp",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceRoot}/rebrgen/tool/ebm2c",
      "args": ["-i", "${workspaceRoot}/rebrgen/save/wasm.ebm"],
      "stopAtEntry": false,
      "cwd": "${workspaceRoot}/rebrgen",
      "environment": [],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      // 建てたものだけが build/debug/bin にある。ここに並んでいても、
      // -t <tool> で建てていなければ「ファイルが無い」で失敗する。
      "id": "nastTool",
      "type": "pickString",
      "description": "which nast tool to debug",
      "options": [
        "nast_backend",
        "nast_corpus",
        "nast_dump",
        "nast_unparse_test",
        "nast_wire_test",
        "nast_test"
      ],
      "default": "nast_backend"
    },
    {
      // 引数が要らないものは空のまま Enter。
      "id": "nastArgs",
      "type": "promptString",
      "description": "arguments (a single .bgn path, or empty)",
      "default": "example/udp.bgn"
    }
  ]
}
