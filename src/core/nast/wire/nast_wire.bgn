            base :Ref
            arguments_ref :Ref
        NodeKind.OrCond:
            type :Ref
            base :Ref
            conds_len :u32
            conds :[conds_len]Ref
        NodeKind.Import:
            type :Ref
            path :Ref

format ResolutionEntry:
    key :Ref
    target :Ref

format ResolutionTable:
    len :u32
    entries :[len]ResolutionEntry

format InnerStructEntry:
    key :Ref
    fields_len :u32
    fields :[fields_len]Ref
    asserts_len :u32
    asserts :[asserts_len]Ref

format InnerStructTable:
    len :u32
    entries :[len]InnerStructEntry

format FormatStateEntry:
    key :Ref
    encode_kind :FormatKind
    decode_kind :FormatKind
    encode_custom :Ref
    decode_custom :Ref
    fields_len :u32
    fields :[fields_len]Ref
    functions_len :u32
    functions :[functions_len]Ref
    asserts_len :u32
    asserts :[asserts_len]Ref
    nested_formats_len :u32
    nested_formats :[nested_formats_len]Ref
    nested_enums_len :u32
    nested_enums :[nested_enums_len]Ref

format FormatStateTable:
    len :u32
    entries :[len]FormatStateEntry

format DocCommentEntry:
    key :Ref
    leading :Loc

format DocCommentTable:
    len :u32
    entries :[len]DocCommentEntry

format IsMutatedEntry:
    key :Ref
    ..

format IsMutatedTable:
    len :u32
    entries :[len]IsMutatedEntry

format UnionFieldsEntry:
    key :Ref
    fields_len :u32
    fields :[fields_len]Ref

format UnionFieldsTable:
    len :u32
    entries :[len]UnionFieldsEntry

format ImportResolutionEntry:
    key :Ref
    module :Ref

format ImportResolutionTable:
    len :u32
    entries :[len]ImportResolutionEntry

format RequirementsEntry:
    key :Ref
    decode_peek :u8
    decode_backward :u8
    decode_remain :u8
    decode_offset :u8
    decode_state_read_len :u32
    decode_state_read :[decode_state_read_len]Ref
    decode_state_write_len :u32
    decode_state_write :[decode_state_write_len]Ref
    encode_peek :u8
    encode_backward :u8
    encode_remain :u8
    encode_offset :u8
    encode_state_read_len :u32
    encode_state_read :[encode_state_read_len]Ref
    encode_state_write_len :u32
    encode_state_write :[encode_state_write_len]Ref

format RequirementsTable:
    len :u32
    entries :[len]RequirementsEntry

format ConstantValueEntry:
    key :Ref
    kind_eval_kind :EvalKind
    integer :u32
    is_negative :u8
    boolean :u8
    string :Ref

format ConstantValueTable:
    len :u32
    entries :[len]ConstantValueEntry

format UnionLayoutEntry:
    key :Ref
    member_types_len :u32
    member_types :[member_types_len]Ref
    cluster_types_len :u32
    cluster_types :[cluster_types_len]Ref

format UnionLayoutTable:
    len :u32
    entries :[len]UnionLayoutEntry

format FieldEndianEntry:
    key :Ref
    endian :Endian
    dynamic :Ref

format FieldEndianTable:
    len :u32
    entries :[len]FieldEndianEntry

format LoweredRangeCompareEntry:
    key :Ref
    expr :Ref

format LoweredRangeCompareTable:
    len :u32
    entries :[len]LoweredRangeCompareEntry

format LoweredMatchEntry:
    key :Ref
    branch :Ref

format LoweredMatchTable:
    len :u32
    entries :[len]LoweredMatchEntry

format LoweredEndianVariableEntry:
    key :Ref
    name :Ref
    value_ref :Ref

format LoweredEndianVariableTable:
    len :u32
    entries :[len]LoweredEndianVariableEntry

format LoweredCondEntry:
    key :Ref
    temp_name :Ref
    type :Ref
    branch :Ref
    value_ref :Ref

format LoweredCondTable:
    len :u32
    entries :[len]LoweredCondEntry

format TypeSizeEntry:
    key :Ref
    kind_size_kind :SizeKind
    bits :u32
    bits_expr :Ref

format TypeSizeTable:
    len :u32
    entries :[len]TypeSizeEntry


format NastModule:
    magic :"NAST"
    version :u8
    strings_len :u32
    strings :[strings_len]StringEntry
    nodes_len :u32
    nodes :[nodes_len]Node
    root :Ref
    resolution :ResolutionTable
    inner_struct :InnerStructTable
    format_state :FormatStateTable
    doc_comment :DocCommentTable
    is_mutated :IsMutatedTable
    union_fields :UnionFieldsTable
    import_resolution :ImportResolutionTable
    requirements :RequirementsTable
    constant_value :ConstantValueTable
    union_layout :UnionLayoutTable
    field_endian :FieldEndianTable
    lowered_range_compare :LoweredRangeCompareTable
    lowered_match :LoweredMatchTable
    lowered_endian_variable :LoweredEndianVariableTable
    lowered_cond :LoweredCondTable
    type_size :TypeSizeTable
