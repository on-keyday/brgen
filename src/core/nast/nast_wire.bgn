# Code generated by src/core/nast/wiregen.py from nodes.json; DO NOT EDIT.
config.cpp.namespace = "brgen::nast::wire"

format Ref:
    id :u32

format Loc:
    begin :u32
    end :u32
    file :u32
    line :u32
    col :u32

format StringEntry:
    len :u32
    data :[len]u8

enum BinaryOp:
    :u8
    mul
    div
    mod
    left_arithmetic_shift
    right_arithmetic_shift
    left_logical_shift
    right_logical_shift
    bit_and
    add
    sub
    bit_or
    bit_xor
    equal
    not_equal
    less
    less_or_eq
    grater
    grater_or_eq
    logical_and
    logical_or
    cond_op1
    cond_op2
    range_exclusive
    range_inclusive
    assign
    define_assign
    const_assign
    add_assign
    sub_assign
    mul_assign
    div_assign
    mod_assign
    left_logical_shift_assign
    right_logical_shift_assign
    left_arithmetic_shift_assign
    right_arithmetic_shift_assign
    bit_and_assign
    bit_or_assign
    bit_xor_assign
    comma
    in_assign
    append_assign

enum UnaryOp:
    :u8
    not_
    minus_sign

enum SpecialLiteralKind:
    :u8
    input_
    output_
    config_

enum Endian:
    :u8
    unspec
    big
    little
    native

enum FormatKind:
    :u8
    as_is
    custom

enum NodeKind:
    :u32
    Module
    BodyStatement
    Field
    Format
    GenericFormat
    Function
    If
    Match
    Loop
    RangeLoop
    Assign
    VariableDefinition
    Metadata
    SpecifyOrder
    Sizeof
    Available
    ExplicitError
    Binary
    Unary
    Call
    Reference
    MemberAccess
    TypeLiteral
    ConditionalStatement
    Parameter
    Body
    Arguments
    Argument
    NamedArgument
    Ident
    IntType
    IntLiteral
    BoolLiteral
    StrLiteral
    CharLiteral
    RegexLiteral
    SpecialLiteral
    Paren
    Index
    Cond
    Range
    BadExpr
    Assert
    FloatType
    BoolType
    VoidType
    IdentType
    ImportedType
    IntLiteralType
    StrLiteralType
    RegexLiteralType
    ArrayType
    FunctionType
    StructType
    InlineStructType
    StructUnionType
    StructUnionCandidate
    UnionType
    RangeType
    EnumType
    MetaType
    OptionalType
    GenericType
    MatchBranch
    UnionCandidate
    Return
    Break
    Continue
    Enum
    EnumMember
    State
    TypeParameter
    FieldArgument
    Identity
    Cast
    OrCond
    Import

format Node:
    node_kind :NodeKind
    loc :Loc
    match node_kind:
        NodeKind.Module:
            statements_len :u32
            statements :[statements_len]Ref
        NodeKind.BodyStatement:
            belong :Ref
            body :Ref
        NodeKind.Field:
            name :Ref
            type :Ref
            arguments_ref :Ref
        NodeKind.Format:
            name :Ref
            belong :Ref
            body :Ref
        NodeKind.GenericFormat:
            name :Ref
            belong :Ref
            body :Ref
            type_parameters_len :u32
            type_parameters :[type_parameters_len]Ref
        NodeKind.Function:
            name :Ref
            belong :Ref
            body :Ref
            parameters_len :u32
            parameters :[parameters_len]Ref
            return_type :Ref
        NodeKind.If:
            type :Ref
            blocks_len :u32
            blocks :[blocks_len]Ref
        NodeKind.Match:
            type :Ref
            blocks_len :u32
            blocks :[blocks_len]Ref
            condition :Ref
        NodeKind.Loop:
            belong :Ref
            body :Ref
            init :Ref
            condition :Ref
            step :Ref
        NodeKind.RangeLoop:
            belong :Ref
            body :Ref
            bind_variable :Ref
            container :Ref
        NodeKind.Assign:
            assignee :Ref
            value_ref :Ref
            op_binary_op :BinaryOp
        NodeKind.VariableDefinition:
            name :Ref
            value_ref :Ref
            op_binary_op :BinaryOp
        NodeKind.Metadata:
            name :Ref
            arguments_ref :Ref
        NodeKind.SpecifyOrder:
            order :Ref
        NodeKind.Sizeof:
            type :Ref
            target :Ref
        NodeKind.Available:
            type :Ref
            target :Ref
            selected_type :Ref
        NodeKind.ExplicitError:
            message :Ref
            extra_arguments :Ref
        NodeKind.Binary:
            type :Ref
            op_binary_op :BinaryOp
            left :Ref
            right :Ref
        NodeKind.Unary:
            type :Ref
            op_unary_op :UnaryOp
            target :Ref
        NodeKind.Call:
            type :Ref
            callee :Ref
            arguments_ref :Ref
        NodeKind.Reference:
            type :Ref
            name :Ref
        NodeKind.MemberAccess:
            type :Ref
            base :Ref
            member :Ref
        NodeKind.TypeLiteral:
            type :Ref
            literal :Ref
        NodeKind.ConditionalStatement:
            belong :Ref
            body :Ref
            condition :Ref
        NodeKind.Parameter:
            name :Ref
            type :Ref
        NodeKind.Body:
            statements_len :u32
            statements :[statements_len]Ref
            end_loc :Loc
        NodeKind.Arguments:
            arguments_list_len :u32
            arguments_list :[arguments_list_len]Ref
            end_loc :Loc
        NodeKind.Argument:
            value_ref :Ref
        NodeKind.NamedArgument:
            value_ref :Ref
            name :Ref
        NodeKind.Ident:
            identifier :Ref
        NodeKind.IntType:
            is_explicit :u8
            bit_size :u32
            is_signed :u8
            endian :Endian
        NodeKind.IntLiteral:
            type :Ref
            value_ref :Ref
        NodeKind.BoolLiteral:
            type :Ref
            value_u8 :u8
        NodeKind.StrLiteral:
            type :Ref
            value_ref :Ref
            binary_value :Ref
        NodeKind.CharLiteral:
            type :Ref
            value_ref :Ref
            code :u32
        NodeKind.RegexLiteral:
            type :Ref
            value_ref :Ref
        NodeKind.SpecialLiteral:
            type :Ref
            kind :SpecialLiteralKind
        NodeKind.Paren:
            type :Ref
            expr :Ref
            end_loc :Loc
        NodeKind.Index:
            type :Ref
            base :Ref
            index :Ref
            end_loc :Loc
        NodeKind.Cond:
            type :Ref
            cond :Ref
            then :Ref
            els_loc :Loc
            els :Ref
        NodeKind.Range:
            type :Ref
            start :Ref
            end :Ref
            op_binary_op :BinaryOp
        NodeKind.BadExpr:
            type :Ref
            content :Ref
            bad_expr :Ref
        NodeKind.Assert:
            expr :Ref
        NodeKind.FloatType:
            is_explicit :u8
            bit_size :u32
            endian :Endian
        NodeKind.BoolType:
            is_explicit :u8
        NodeKind.VoidType:
            is_explicit :u8
        NodeKind.IdentType:
            is_explicit :u8
            base :Ref
            ident :Ref
        NodeKind.ImportedType:
            is_explicit :u8
            base :Ref
            import_ref :Ref
        NodeKind.IntLiteralType:
            is_explicit :u8
            base :Ref
        NodeKind.StrLiteralType:
            is_explicit :u8
            base :Ref
        NodeKind.RegexLiteralType:
            is_explicit :u8
            base :Ref
        NodeKind.ArrayType:
            is_explicit :u8
            length :Ref
            end_loc :Loc
            element_type :Ref
        NodeKind.FunctionType:
            is_explicit :u8
            return_type :Ref
            parameters_len :u32
            parameters :[parameters_len]Ref
        NodeKind.StructType:
            is_explicit :u8
            base :Ref
        NodeKind.InlineStructType:
            is_explicit :u8
            inlined_format :Ref
        NodeKind.StructUnionType:
            is_explicit :u8
            base :Ref
            candidates_len :u32
            candidates :[candidates_len]Ref
        NodeKind.StructUnionCandidate:
            cond :Ref
            inner_struct :Ref
        NodeKind.UnionType:
            is_explicit :u8
            cond :Ref
            candidates_len :u32
            candidates :[candidates_len]Ref
            base_type :Ref
            common_type :Ref
            is_strict_common_type :u8
            member_candidates_len :u32
            member_candidates :[member_candidates_len]Ref
        NodeKind.RangeType:
            is_explicit :u8
            base_type :Ref
            range :Ref
        NodeKind.EnumType:
            is_explicit :u8
            base :Ref
        NodeKind.MetaType:
            is_explicit :u8
        NodeKind.OptionalType:
            is_explicit :u8
            base_type :Ref
        NodeKind.GenericType:
            is_explicit :u8
            base_type :Ref
            type_arguments_len :u32
            type_arguments :[type_arguments_len]Ref
        NodeKind.MatchBranch:
            belong :Ref
            cond :Ref
            sym_loc :Loc
            then :Ref
        NodeKind.UnionCandidate:
            cond :Ref
            field :Ref
        NodeKind.Return:
            expr :Ref
            related_function :Ref
        NodeKind.Break:
            related_loop :Ref
        NodeKind.Continue:
            related_loop :Ref
        NodeKind.Enum:
            name :Ref
            base_type :Ref
            members_len :u32
            members :[members_len]Ref
            enum_type :Ref
        NodeKind.EnumMember:
            name :Ref
            raw_expr :Ref
            value_ref :Ref
            str_literal :Ref
        NodeKind.State:
            name :Ref
            belong :Ref
            body :Ref
        NodeKind.TypeParameter:
            name :Ref
            belong :Ref
        NodeKind.FieldArgument:
            raw_arguments :Ref
            arguments_list_len :u32
            arguments_list :[arguments_list_len]Ref
            assigns_len :u32
            assigns :[assigns_len]Ref
            alignment :Ref
            sub_byte_length :Ref
            sub_byte_begin :Ref
        NodeKind.Identity:
            type :Ref
            expr :Ref
        NodeKind.Cast:
            type :Ref
            base :Ref
            arguments_ref :Ref
        NodeKind.OrCond:
            type :Ref
            base :Ref
            conds_len :u32
            conds :[conds_len]Ref
        NodeKind.Import:
            type :Ref
            path :Ref

format ResolutionEntry:
    key :Ref
    target :Ref

format ResolutionTable:
    len :u32
    entries :[len]ResolutionEntry

format InnerStructEntry:
    key :Ref
    fields_len :u32
    fields :[fields_len]Ref
    asserts_len :u32
    asserts :[asserts_len]Ref

format InnerStructTable:
    len :u32
    entries :[len]InnerStructEntry

format FormatStateEntry:
    key :Ref
    encode_kind :FormatKind
    decode_kind :FormatKind
    encode_custom :Ref
    decode_custom :Ref
    fields_len :u32
    fields :[fields_len]Ref
    functions_len :u32
    functions :[functions_len]Ref
    asserts_len :u32
    asserts :[asserts_len]Ref
    nested_formats_len :u32
    nested_formats :[nested_formats_len]Ref
    nested_enums_len :u32
    nested_enums :[nested_enums_len]Ref

format FormatStateTable:
    len :u32
    entries :[len]FormatStateEntry

format DocCommentEntry:
    key :Ref
    leading :Loc

format DocCommentTable:
    len :u32
    entries :[len]DocCommentEntry

format IsMutatedEntry:
    key :Ref
    ..

format IsMutatedTable:
    len :u32
    entries :[len]IsMutatedEntry

format UnionFieldsEntry:
    key :Ref
    fields_len :u32
    fields :[fields_len]Ref

format UnionFieldsTable:
    len :u32
    entries :[len]UnionFieldsEntry

format ImportResolutionEntry:
    key :Ref
    module :Ref

format ImportResolutionTable:
    len :u32
    entries :[len]ImportResolutionEntry


format NastModule:
    magic :"NAST"
    version :u8
    strings_len :u32
    strings :[strings_len]StringEntry
    nodes_len :u32
    nodes :[nodes_len]Node
    root :Ref
    resolution :ResolutionTable
    inner_struct :InnerStructTable
    format_state :FormatStateTable
    doc_comment :DocCommentTable
    is_mutated :IsMutatedTable
    union_fields :UnionFieldsTable
    import_resolution :ImportResolutionTable
